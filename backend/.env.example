# ─── Meraki — Desenvolvimento local (monorepo) ─────────────────────────────
# Usado por: docker compose up (docker-compose.yml — todos os serviços juntos)
# Este arquivo é APENAS para desenvolvimento local em uma única máquina.
#
# Para deploy em servidores separados, use o .env.example de cada serviço
# individualmente e consulte DEPLOY.md.
#
# Copie para .env e ajuste: cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ─── Banco de dados ───────────────────────────────────────────────────────────
JWT_SECRET=meraki-jwt-secret-change-in-production
RABBITMQ_URL=amqp://meraki:meraki@localhost:5672
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=project_db
PORT=3002
NODE_ENV=development

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=meraki
RABBITMQ_PASS=meraki

# ─── E-mail (Mailtrap sandbox — pegar credenciais com o responsável) ──────────
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
FRONTEND_URL=http://localhost:5173